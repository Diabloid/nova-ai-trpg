# API Ключі для мультипровайдерного пулу NOVA AI TRPG (story / state / fast)
# Скопіюйте цей файл як .env та вставте ваші реальні ключі

# Odirouter — безкоштовні моделі (динамічне виявлення через /v1/models)
ODIROUTER_API_KEY=your_odirouter_api_key_here

# Google AI Studio — OpenAI-сумісний endpoint (Gemini / Gemma)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter — безкоштовні :free моделі (резерв)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq — надшвидкий Whisper STT + легка роль fast / резерв (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Experiential Labs — аварійний резерв із дешевими моделями (лише коли решта пулу недоступна)
EXPERIENTIAL_API_KEY=your_experiential_api_key_here
