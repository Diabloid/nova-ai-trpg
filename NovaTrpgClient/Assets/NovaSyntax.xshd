<?xml version="1.0"?>
<SyntaxDefinition name="NovaSyntax" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <!-- Палітра кольорів -->
    <Color name="Action" foreground="#EAB308" fontWeight="bold" />      <!-- Жовтий для дій -->
    <Color name="Speech" foreground="#4ADE80" />                        <!-- Зелений для слів -->
    <Color name="Thought" foreground="#60A5FA" fontStyle="italic" />    <!-- Блакитний для думок -->
    <Color name="OOC" foreground="#9CA3AF" />                           <!-- Сірий для позаігрового -->

    <RuleSet>
        <!-- Дії в **зірочках** із захистом від екранування -->
        <Span color="Action" multiline="true">
            <Begin>(?&lt;!\\)\*\*</Begin>
            <End>(?&lt;!\\)\*\*</End>
        </Span>
        
        <!-- Думки в "лапках" -->
        <Span color="Thought" multiline="true">
            <Begin>(?&lt;!\\)&quot;</Begin>
            <End>(?&lt;!\\)&quot;</End>
        </Span>
        
        <!-- Позаігрове в (дужках) -->
        <Span color="OOC" multiline="true">
            <Begin>(?&lt;!\\)\(</Begin>
            <End>(?&lt;!\\)\)</End>
        </Span>
        
        <!-- Пряма мова, що починається з дефіса (до кінця рядка) -->
        <Span color="Speech" multiline="false">
            <Begin>(?&lt;!\\)\-</Begin>
            <End>$</End>
        </Span>
    </RuleSet>
</SyntaxDefinition>
