<?xml version="1.0"?>
<SyntaxDefinition name="NovaSyntax" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <!-- Палітра кольорів -->
    <Color name="Action" foreground="#EAB308" fontWeight="bold" />      <!-- Жовтий для дій -->
    <Color name="Speech" foreground="#4ADE80" />                        <!-- Зелений для слів -->
    <Color name="Thought" foreground="#60A5FA" fontStyle="italic" />    <!-- Блакитний для думок -->
    <Color name="OOC" foreground="#9CA3AF" />                           <!-- Сірий для позаігрового -->

    <RuleSet>
        <!-- Пряма мова, що починається з дефіса/тире (до кінця рядка) -->
        <Span color="Speech" multiline="false">
            <Begin>(?&lt;!\\)[\-\u2013\u2014](?![\u200B])</Begin>
            <End>$</End>
        </Span>

        <!-- Дія в **зірочках** (забарвлюється тільки коли є пара; всередині підтримує "думки" синім кольором) -->
        <Span color="Action" multiline="false">
            <Begin>(?&lt;!\\)\*\*(?![\u200B])(?=.*?(?&lt;!\\)\*\*)</Begin>
            <End>(?&lt;!\\)\*\*</End>
            <RuleSet>
                <!-- Думка всередині дії: забарвлюється синім -->
                <Span color="Thought" multiline="false">
                    <Begin>(?&lt;!\\)&quot;(?![\u200B])(?=.*?(?&lt;!\\)&quot;)</Begin>
                    <End>(?&lt;!\\)&quot;</End>
                </Span>
                <!-- Позаігрове всередині дії: забарвлюється сірим -->
                <Span color="OOC" multiline="false">
                    <Begin>(?&lt;!\\)\((?![\u200B])(?=.*?(?&lt;!\\)\))</Begin>
                    <End>(?&lt;!\\)\)</End>
                </Span>
            </RuleSet>
        </Span>
        
        <!-- Думка в "лапках" на верхньому рівні (забарвлюється тільки після закриваючої лапки) -->
        <Span color="Thought" multiline="false">
            <Begin>(?&lt;!\\)&quot;(?![\u200B])(?=.*?(?&lt;!\\)&quot;)</Begin>
            <End>(?&lt;!\\)&quot;</End>
            <RuleSet>
                <!-- Дія всередині думки: забарвлюється золотим -->
                <Span color="Action" multiline="false">
                    <Begin>(?&lt;!\\)\*\*(?![\u200B])(?=.*?(?&lt;!\\)\*\*)</Begin>
                    <End>(?&lt;!\\)\*\*</End>
                </Span>
            </RuleSet>
        </Span>
        
        <!-- Позаігрове в (дужках) на верхньому рівні -->
        <Span color="OOC" multiline="false">
            <Begin>(?&lt;!\\)\((?![\u200B])(?=.*?(?&lt;!\\)\))</Begin>
            <End>(?&lt;!\\)\)</End>
        </Span>
    </RuleSet>
</SyntaxDefinition>
