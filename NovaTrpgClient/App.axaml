<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaTrpgClient.App"
             xmlns:local="using:NovaTrpgClient"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- ПЕРЕВИЗНАЧЕННЯ ДЕФОЛТНИХ БЛІКІВ КНОПОК FLUENTTHEME НА ЧИСТИЙ ТЕМНИЙ СТИЛЬ -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#222222"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonForeground" Color="#D1D5DB"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E5E7EB"/>
                    <!-- ФІРМОВЕ ВИДІЛЕННЯ ТЕКСТУ (ГЛИБОКИЙ РУБІН З ЧІТКИМ БІЛИМ ТЕКСТОМ) -->
                    <SolidColorBrush x:Key="TextControlSelectionHighlightBrush" Color="#6A0014"/>
                    <SolidColorBrush x:Key="HighlightBrush" Color="#6A0014"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#222222"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonForeground" Color="#D1D5DB"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="TextControlSelectionHighlightBrush" Color="#6A0014"/>
                    <SolidColorBrush x:Key="HighlightBrush" Color="#6A0014"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- ФІРМОВИЙ СТИЛЬ ВИДІЛЕННЯ ТЕКСТУ ДЛЯ ВСІХ ТЕКСТОВИХ ПОЛІВ -->
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="#6A0014"/>
            <Setter Property="SelectionForegroundBrush" Value="#FFFFFF"/>
        </Style>

        <!-- ПОВНЕ ВИМКНЕННЯ СТАНДАРТНОЇ НАКЛАДНОЇ ШАПКИ AVALONIA 12 (ПРИ ЗБЕРЕЖЕННІ FULL DWM АНІМАЦІЙ WINDOWS) -->
        <Style Selector="WindowDrawnDecorations">
            <Setter Property="DefaultTitleBarHeight" Value="0"/>
            <Setter Property="DefaultFrameThickness" Value="0"/>
            <Setter Property="DefaultShadowThickness" Value="0"/>
            <Setter Property="Template" Value="{x:Null}"/>
        </Style>
    </Application.Styles>
</Application>
