<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaTrpgClient.App"
             xmlns:local="using:NovaTrpgClient"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- ПЕРЕВИЗНАЧЕННЯ ДЕФОЛТНИХ БЛІКІВ КНОПОК FLUENTTHEME НА ЧИСТИЙ ТЕМНИЙ СТИЛЬ -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#222222"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonForeground" Color="#D1D5DB"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E5E7EB"/>
                    <!-- УНІФІКОВАНИЙ СТИЛЬ ВИДІЛЕННЯ ТЕКСТУ (ІДЕНТИЧНИЙ ДО CHATINPUTEDITOR) -->
                    <SolidColorBrush x:Key="TextControlSelectionHighlightBrush" Color="#3F3F3F"/>
                    <SolidColorBrush x:Key="HighlightBrush" Color="#3F3F3F"/>
                    <!-- КОНТЕКСТНЕ МЕНЮ — ПОВНЕ УСУНЕННЯ ТЕМНИХ ПРЯМОКУТНИКІВ НА ХОВЕРІ -->
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#222222"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="MenuItemBackgroundSelected" Color="#222222"/>
                    <SolidColorBrush x:Key="MenuItemBackgroundSelectedPointerOver" Color="#2A2A2A"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#222222"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonForeground" Color="#D1D5DB"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="TextControlSelectionHighlightBrush" Color="#3F3F3F"/>
                    <SolidColorBrush x:Key="HighlightBrush" Color="#3F3F3F"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#222222"/>
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="MenuItemBackgroundSelected" Color="#222222"/>
                    <SolidColorBrush x:Key="MenuItemBackgroundSelectedPointerOver" Color="#2A2A2A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- УНІФІКОВАНИЙ СТИЛЬ ВИДІЛЕННЯ ТА КОНТЕКСТНОГО МЕНЮ ДЛЯ ВСІХ TEXTBOX В ПРОЄКТІ -->
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="#3F3F3F"/>
            <Setter Property="SelectionForegroundBrush" Value="#FFFFFF"/>
            <Setter Property="ClearSelectionOnLostFocus" Value="False"/>
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionBrush" Value="#3F3F3F"/>
            <Setter Property="SelectionForegroundBrush" Value="#FFFFFF"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#262626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- ПОВНЕ ВИМКНЕННЯ СТАНДАРТНОЇ НАКЛАДНОЇ ШАПКИ AVALONIA 12 (ПРИ ЗБЕРЕЖЕННІ FULL DWM АНІМАЦІЙ WINDOWS) -->
        <Style Selector="WindowDrawnDecorations">
            <Setter Property="DefaultTitleBarHeight" Value="0"/>
            <Setter Property="DefaultFrameThickness" Value="0"/>
            <Setter Property="DefaultShadowThickness" Value="0"/>
            <Setter Property="Template" Value="{x:Null}"/>
        </Style>
    </Application.Styles>
</Application>
