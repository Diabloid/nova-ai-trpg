<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaTrpgClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NovaTrpgClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NOVA AI TRPG" MinWidth="800" MinHeight="600"
        Background="#121212"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Resources>
		<SolidColorBrush x:Key="ScrollBarThumbFill" Color="#262626"/>
		<SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#383838"/>
		<SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#444444"/>
	</Window.Resources>

	<Window.Styles>
		<!-- МІНІМАЛІСТИЧНИЙ УЛЬТРА-ТОНКИЙ СКРОЛБАР (4px, БЕЗ СТРІЛОК) -->
		<Style Selector="ScrollBar:vertical">
			<Setter Property="AllowAutoHide" Value="False"/>
			<Setter Property="Width" Value="4"/>
			<Setter Property="MinWidth" Value="4"/>
			<Setter Property="MaxWidth" Value="4"/>
		</Style>
		<Style Selector="ScrollBar:vertical /template/ Track">
			<Setter Property="Width" Value="4"/>
			<Setter Property="MinWidth" Value="4"/>
			<Setter Property="MaxWidth" Value="4"/>
		</Style>
		<Style Selector="ScrollBar:vertical /template/ Thumb">
			<Setter Property="Width" Value="4"/>
			<Setter Property="MinWidth" Value="4"/>
			<Setter Property="MaxWidth" Value="4"/>
			<Setter Property="Background" Value="#262626"/>
			<Setter Property="CornerRadius" Value="2"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
			<Setter Property="Background" Value="#383838"/>
		</Style>
		<Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
			<Setter Property="Background" Value="#383838"/>
		</Style>
		<Style Selector="ScrollBar:vertical:pressed /template/ Thumb">
			<Setter Property="Background" Value="#444444"/>
		</Style>
		<Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
			<Setter Property="Background" Value="#444444"/>
		</Style>
		<Style Selector="ScrollBar:vertical /template/ RepeatButton">
			<Setter Property="IsVisible" Value="False"/>
			<Setter Property="Height" Value="0"/>
			<Setter Property="Width" Value="0"/>
		</Style>

		<!-- ЕФЕКТИ ПОЛЯ ВВОДУ -->
		<Style Selector="Border.inputBox">
			<Setter Property="BorderBrush" Value="#333333"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.inputBox:focus-within">
			<Setter Property="BorderBrush" Value="#5A0010"/>
		</Style>

		<!-- БОРДОВА КНОПКА ВІДПРАВКИ -->
		<Style Selector="Button.sendBtn">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Width" Value="48"/>
			<Setter Property="Height" Value="48"/>
			<Setter Property="Background">
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
					<GradientStop Color="#4A000A" Offset="0.0"/>
					<GradientStop Color="#2A0005" Offset="1.0"/>
				</LinearGradientBrush>
			</Setter>
		</Style>
		<Style Selector="Button.sendBtn /template/ ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.2"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.sendBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background">
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
					<GradientStop Color="#6A0010" Offset="0.0"/>
					<GradientStop Color="#4A000A" Offset="1.0"/>
				</LinearGradientBrush>
			</Setter>
		</Style>
		<Style Selector="Button.sendBtn:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="#2A0005"/>
		</Style>

		<!-- КАРТКА ПЕРСОНАЖА (ВЕРХНЯ ПАНЕЛЬ) -->
		<Style Selector="Button.characterCard">
			<Setter Property="Background" Value="#1A1A1A"/>
			<Setter Property="BorderBrush" Value="#2A2A2A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="20,10"/>
		</Style>
		<Style Selector="Button.characterCard /template/ ContentPresenter">
			<!-- Плавна анімація кольорів при наведенні та натисканні без різких стрибків -->
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut"/>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="SineEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.characterCard:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#1E1E1E"/>
			<Setter Property="BorderBrush" Value="#4A1218"/>
		</Style>
		<Style Selector="Button.characterCard:pressed /template/ ContentPresenter">
			<!-- М'яке, благородне притемнення без "провалу" в чорний колір -->
			<Setter Property="Background" Value="#161616"/>
			<Setter Property="BorderBrush" Value="#5A0010"/>
		</Style>

		<!-- ПУНКТИ СИСТЕМНОГО МЕНЮ -->
		<Style Selector="Button.menuItem">
			<Setter Property="Background" Value="#1A1A1A"/>
			<Setter Property="Foreground" Value="#E5E7EB"/>
			<Setter Property="BorderBrush" Value="#2A2A2A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="16,12"/>
		</Style>
		<Style Selector="Button.menuItem /template/ ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut"/>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="SineEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.menuItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#222222"/>
			<Setter Property="BorderBrush" Value="#353535"/>
		</Style>
		<Style Selector="Button.menuItem:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="#161616"/>
			<Setter Property="BorderBrush" Value="#262626"/>
		</Style>

		<!-- КНОПКА ВИХОДУ З ГРИ -->
		<Style Selector="Button.menuExitBtn">
			<Setter Property="Background" Value="#2A1010"/>
			<Setter Property="Foreground" Value="#FCA5A5"/>
			<Setter Property="BorderBrush" Value="#3D1515"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="16,12"/>
		</Style>
		<Style Selector="Button.menuExitBtn /template/ ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut"/>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="SineEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.menuExitBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#3D1212"/>
			<Setter Property="BorderBrush" Value="#5C1818"/>
		</Style>
		<Style Selector="Button.menuExitBtn:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="#200A0A"/>
			<Setter Property="BorderBrush" Value="#320808"/>
		</Style>

		<!-- КНОПКА ДІЇ В МЕНЮ (Завантаження сесії) -->
		<Style Selector="Button.menuActionBtn">
			<Setter Property="Background" Value="#222222"/>
			<Setter Property="Foreground" Value="#E5E7EB"/>
			<Setter Property="BorderBrush" Value="#333333"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="Button.menuActionBtn /template/ ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut"/>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="SineEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.menuActionBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#2C2C2C"/>
			<Setter Property="BorderBrush" Value="#5A0010"/>
		</Style>
		<Style Selector="Button.menuActionBtn:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="#1A1A1A"/>
			<Setter Property="BorderBrush" Value="#4A000A"/>
		</Style>

		<!-- ПОЛЕ ВВОДУ СЕСІЇ -->
		<Style Selector="TextBox.sessionInput">
			<Setter Property="Background" Value="#141414"/>
			<Setter Property="BorderBrush" Value="#2A2A2A"/>
			<Setter Property="Foreground" Value="#E5E7EB"/>
			<Setter Property="CaretBrush" Value="#E5E7EB"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="TextBox.sessionInput /template/ Border#PART_BorderElement">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut"/>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="SineEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="TextBox.sessionInput:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="#1A1A1A"/>
			<Setter Property="BorderBrush" Value="#444444"/>
		</Style>
		<Style Selector="TextBox.sessionInput:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="#161616"/>
			<Setter Property="BorderBrush" Value="#5A0010"/>
		</Style>
		<Style Selector="TextBox.sessionInput:focus:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="#181818"/>
			<Setter Property="BorderBrush" Value="#6A0010"/>
		</Style>

		<!-- АНІМАЦІЯ ВИСУВНОЇ ШТОРКИ ПЕРСОНАЖА -->
		<Style Selector="Border.drawerSheet">
			<Setter Property="MaxHeight" Value="0"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="MaxHeight" Duration="0:0:0.35" Easing="CubicEaseOut"/>
					<DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="SineEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.drawerSheet.open">
			<Setter Property="MaxHeight" Value="450"/>
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="IsHitTestVisible" Value="True"/>
		</Style>

		<!-- ПЛАВНИЙ ПОВОРОТ СТРІЛОЧКИ (CHEVRON) -->
		<Style Selector="TextBlock.chevron">
			<Setter Property="RenderTransform" Value="rotate(0deg)"/>
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="TextBlock.chevron.open">
			<Setter Property="RenderTransform" Value="rotate(180deg)"/>
		</Style>

		<!-- ПЛАВНИЙ ТА ВЕЛИЧНИЙ РУХ БІЧНОГО МЕНЮ (ВІДКРИТТЯ І ЗАКРИТТЯ) -->
		<Style Selector="SplitView /template/ Panel#PART_PaneRoot">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Width" Duration="0:0:0.55" Easing="CubicEaseInOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="SplitView:open /template/ Panel#PART_PaneRoot">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Width" Duration="0:0:0.55" Easing="CubicEaseInOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="SplitView:closed /template/ Panel#PART_PaneRoot">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Width" Duration="0:0:0.55" Easing="CubicEaseInOut"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="SplitView /template/ ContentPresenter#PART_ContentRoot">
			<Setter Property="Transitions">
				<Transitions>
					<ThicknessTransition Property="Margin" Duration="0:0:0.55" Easing="CubicEaseInOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="SplitView:open /template/ ContentPresenter#PART_ContentRoot">
			<Setter Property="Transitions">
				<Transitions>
					<ThicknessTransition Property="Margin" Duration="0:0:0.55" Easing="CubicEaseInOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="SplitView:closed /template/ ContentPresenter#PART_ContentRoot">
			<Setter Property="Transitions">
				<Transitions>
					<ThicknessTransition Property="Margin" Duration="0:0:0.55" Easing="CubicEaseInOut"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- М'ЯКИЙ ПРОЯВ ТА ЗГАСАННЯ ВМІСТУ БІЧНОГО МЕНЮ -->
		<Style Selector="Border#MenuPaneContainer">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="SineEaseInOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="SplitView[IsPaneOpen=True] Border#MenuPaneContainer">
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="SplitView[IsPaneOpen=False] Border#MenuPaneContainer">
			<Setter Property="Opacity" Value="0"/>
		</Style>

		<!-- КОНТЕКСТНЕ МЕНЮ (ПКМ) -->
		<Style Selector="MenuItem">
			<Setter Property="CornerRadius" Value="0"/>
		</Style>
		<Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="#111111"/>
		</Style>

		<!-- СТИЛЬ TOOLTIP -->
		<Style Selector="ToolTip">
			<Setter Property="Background" Value="#111111"/>
			<Setter Property="BorderBrush" Value="#2A2A2A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#9CA3AF"/>
		</Style>

		<!-- КНОПКА МЕНЮ -->
		<Style Selector="ToggleButton.menuBtn">
			<Setter Property="Background" Value="#1A1A1A"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="BorderBrush" Value="#2A2A2A"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<Style Selector="ToggleButton.menuBtn /template/ ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseOut"/>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="SineEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="ToggleButton.menuBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#222222"/>
			<Setter Property="BorderBrush" Value="#383838"/>
		</Style>
		<Style Selector="ToggleButton.menuBtn:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="#242424"/>
			<Setter Property="BorderBrush" Value="#5A0010"/>
		</Style>
	</Window.Styles>

	<Grid>
		<!-- Основний макет зі SplitView -->
		<SplitView IsPaneOpen="{Binding IsMenuOpen, Mode=TwoWay}"
		           DisplayMode="Inline"
		           OpenPaneLength="250"
		           PaneBackground="#111111"
		           Background="#121212">

			<!-- БІЧНЕ СИСТЕМНЕ МЕНЮ (Сейви, Сесії, Вихід) -->
			<SplitView.Pane>
				<Border x:Name="MenuPaneContainer" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" ClipToBounds="True">
					<!-- Фіксована ширина 210 запобігає зминанню тексту під час анімації розсування -->
					<StackPanel Width="210" Margin="20,60,20,20" Spacing="12" HorizontalAlignment="Left">
						<TextBlock Text="СИСТЕМНЕ МЕНЮ" HorizontalAlignment="Center" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,4" LetterSpacing="1"/>

						<!-- БЛОК ВИБОРУ/ВВЕДЕННЯ ІГРОВОЇ СЕСІЇ -->
						<Border Background="#181818" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="12">
							<StackPanel Spacing="8">
								<TextBlock Text="ІГРОВА СЕСІЯ" Foreground="#9CA3AF" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
								
								<TextBox x:Name="SessionInputBox"
								         Classes="sessionInput"
								         Text="{Binding SessionIdInput, Mode=TwoWay}"
								         PlaceholderText="default"
								         FontSize="12"
								         Height="32"
								         Padding="8,4"/>

								<Button Classes="menuActionBtn"
								        Command="{Binding SwitchSessionCommand}"
								        Content="📂 Завантажити сесію"
								        HorizontalAlignment="Stretch"
								        HorizontalContentAlignment="Center"
								        FontSize="12"
								        Padding="8,6"
								        Cursor="Hand"/>

								<!-- Відображення поточної активної сесії -->
								<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,2,0,0">
									<TextBlock Text="Активна:" Foreground="#6B7280" FontSize="11"/>
									<TextBlock Text="{Binding SessionId}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<Button Classes="menuItem" Command="{Binding RefreshSessionCommand}" Content="🔄 Оновити стан" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"/>
						<Button Classes="menuItem" Command="{Binding ToggleCharacterSheetCommand}" Content="📜 Лист персонажа" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"/>

						<Separator Background="#2A2A2A" Height="1" Margin="0,4"/>
						<Button Classes="menuExitBtn" Command="{Binding ExitGameCommand}" Content="🚪 Вихід з гри" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"/>
					</StackPanel>
				</Border>
			</SplitView.Pane>

			<!-- ОСНОВНИЙ ІНТЕРФЕЙС -->
			<SplitView.Content>
				<Grid RowDefinitions="Auto, *, Auto" Margin="24,40,24,24">

					<!-- ВЕРХНЯ ПАНЕЛЬ З ВИСУВНОЮ ШТОРКОЮ ПЕРСОНАЖА -->
					<StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="8">
						<!-- ГОЛОВНА ЛАКОНІЧНА СМУГА СТАНУ -->
						<Grid ColumnDefinitions="Auto, *">
							<ToggleButton Grid.Column="0" Classes="menuBtn" IsChecked="{Binding IsMenuOpen, Mode=TwoWay}" Content="☰" Foreground="#E5E7EB" FontSize="20" Width="44" Height="44" Margin="0,0,16,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Cursor="Hand"/>
							
							<!-- Клікабельна плашка персонажа (відкриває/закриває детальну шторку) -->
							<Button Grid.Column="1" Classes="characterCard" Command="{Binding ToggleCharacterSheetCommand}"
							        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand">
								<Grid ColumnDefinitions="Auto, *, Auto">
									<!-- Інфо персонажа -->
									<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
										<TextBlock Text="👤" FontSize="16" VerticalAlignment="Center"/>
										<StackPanel VerticalAlignment="Center">
											<TextBlock Text="{Binding CharacterName}" Foreground="#F3F4F6" FontWeight="Bold" FontSize="15"/>
											<TextBlock Text="{Binding LocationText}" Foreground="#9CA3AF" FontSize="12"/>
										</StackPanel>
									</StackPanel>

									<!-- Загальний стан здоров'я -->
									<StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
										<TextBlock Text="❤" Foreground="#EF4444" FontSize="14" VerticalAlignment="Center"/>
										<TextBlock Text="{Binding HpText}" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
									</StackPanel>

									<!-- Індикатор шторки зі стрілочкою -->
									<TextBlock Grid.Column="2" Classes="chevron" Classes.open="{Binding IsCharacterSheetOpen}" Text="▼" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0"/>
								</Grid>
							</Button>
						</Grid>

						<!-- ДЕТАЛЬНА ВИСУВНА ШТОРКА (TOP DRAWER: Анатомія, Травми, Worn, Containers) -->
						<Border Classes="drawerSheet"
						        Classes.open="{Binding IsCharacterSheetOpen}"
						        ClipToBounds="True"
						        Background="#161616" CornerRadius="10" Padding="16" BorderBrush="#333333">
							<Grid ColumnDefinitions="*, *, *">
								<!-- Колонка 1: Анатомія та Травми -->
								<Border Grid.Column="0" Background="#1C1C1C" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#2A2A2A" BorderThickness="1" MaxHeight="340">
									<Grid RowDefinitions="Auto, *">
										<StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
											<TextBlock Text="🩸 ТРАВМИ ТА АНАТОМІЯ" FontWeight="Bold" Foreground="#EF4444" FontSize="12" LetterSpacing="0.5"/>
											<TextBlock Text="{Binding CharacterAppearance}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" FontStyle="Italic"/>
										</StackPanel>
										<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
											<StackPanel Spacing="4">
												<ItemsControl ItemsSource="{Binding Injuries}">
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Border Background="#261214" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="#5A151B" BorderThickness="1">
																<StackPanel>
																	<TextBlock Text="{Binding Location}" FontWeight="Bold" Foreground="#FCA5A5" FontSize="12"/>
																	<TextBlock Text="{Binding Description}" Foreground="#E5E7EB" FontSize="11" TextWrapping="Wrap"/>
																</StackPanel>
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
												<TextBlock Text="Немає активних травм" Foreground="#6B7280" FontSize="12" FontStyle="Italic"
												           IsVisible="{Binding !Injuries.Count}"/>
											</StackPanel>
										</ScrollViewer>
									</Grid>
								</Border>

								<!-- Колонка 2: Екіпірування (Worn) -->
								<Border Grid.Column="1" Background="#1C1C1C" CornerRadius="8" Padding="12" Margin="4,0,4,0" BorderBrush="#2A2A2A" BorderThickness="1" MaxHeight="340">
									<Grid RowDefinitions="Auto, *">
										<TextBlock Grid.Row="0" Text="🛡 ЕКІПІРУВАННЯ (WORN)" FontWeight="Bold" Foreground="#60A5FA" FontSize="12" LetterSpacing="0.5" Margin="0,0,0,8"/>
										<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
											<StackPanel Spacing="4">
												<ItemsControl ItemsSource="{Binding WornItems}">
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Border Background="#131E2B" CornerRadius="6" Padding="8,5" Margin="0,0,0,6" BorderBrush="#1E3A5F" BorderThickness="1" ToolTip.Tip="{Binding Desc}">
																<StackPanel>
																	<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#93C5FD" FontSize="12"/>
																	<TextBlock Text="{Binding Desc}" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
																</StackPanel>
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
												<TextBlock Text="Нічого не одягнено" Foreground="#6B7280" FontSize="12" FontStyle="Italic"
												           IsVisible="{Binding !WornItems.Count}"/>
											</StackPanel>
										</ScrollViewer>
									</Grid>
								</Border>

								<!-- Колонка 3: Контейнери та Інвентар -->
								<Border Grid.Column="2" Background="#1C1C1C" CornerRadius="8" Padding="12" Margin="8,0,0,0" BorderBrush="#2A2A2A" BorderThickness="1" MaxHeight="340">
									<Grid RowDefinitions="Auto, *">
										<TextBlock Grid.Row="0" Text="🎒 КОНТЕЙНЕРИ ТА РЮКЗАК" FontWeight="Bold" Foreground="#34D399" FontSize="12" LetterSpacing="0.5" Margin="0,0,0,8"/>
										<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
											<StackPanel Spacing="4">
												<ItemsControl ItemsSource="{Binding ContainersList}">
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Border Background="#0F241C" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="#144231" BorderThickness="1">
																<StackPanel Spacing="3">
																	<TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#6EE7B7" FontSize="12"/>
																	<ItemsControl ItemsSource="{Binding Items}">
																		<ItemsControl.ItemTemplate>
																			<DataTemplate>
																				<StackPanel Margin="6,2,0,0" ToolTip.Tip="{Binding Desc}">
																					<TextBlock Text="{Binding Name, StringFormat='• {0}'}" Foreground="#D1FAE5" FontSize="11" FontWeight="Medium"/>
																					<TextBlock Text="{Binding Desc}" Foreground="#86EFAC" Opacity="0.75" FontSize="10" Margin="10,1,0,2" TextWrapping="Wrap"/>
																				</StackPanel>
																			</DataTemplate>
																		</ItemsControl.ItemTemplate>
																	</ItemsControl>
																</StackPanel>
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
												<TextBlock Text="Контейнери порожні" Foreground="#6B7280" FontSize="12" FontStyle="Italic"
												           IsVisible="{Binding !ContainersList.Count}"/>
											</StackPanel>
										</ScrollViewer>
									</Grid>
								</Border>
							</Grid>
						</Border>
					</StackPanel>

					<!-- ЛОГ ПОВІДОМЛЕНЬ + ІНДИКАТОР -->
					<Border Grid.Row="1" Background="#111111" CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1" Padding="20,10,4,10">
						<ScrollViewer x:Name="ChatScroll" Padding="0,0,16,0">
							<StackPanel>
								<ItemsControl ItemsSource="{Binding ChatMessages}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,0,0,24">
												<TextBlock Text="{Binding Sender}" Foreground="{Binding SenderColor}" FontWeight="Bold" Margin="0,0,0,6" FontSize="15"/>
												<TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#E5E7EB" LineHeight="26" FontSize="15" LetterSpacing="0.3"/>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<!-- ІНДИКАТОР ОЧІКУВАННЯ ТА СТАНУ ПАЙПЛАЙНУ -->
								<StackPanel IsVisible="{Binding IsTyping}" Margin="0,0,0,24" Orientation="Vertical" Spacing="4">
									<TextBlock Text="Оповідач:" FontWeight="Bold" Foreground="#EAB308" FontSize="15"/>
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="{Binding StatusIndicatorText}" FontStyle="Italic" Foreground="#9CA3AF" FontSize="15"/>
										<TextBlock Text="{Binding AnimatedDots}" FontStyle="Italic" Foreground="#9CA3AF" FontSize="15" Width="20"/>
									</StackPanel>
								</StackPanel>
							</StackPanel>
						</ScrollViewer>
					</Border>

					<!-- ПОЛЕ ВВОДУ ТА ЕЛЕМЕНТИ -->
					<Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,16,0,0">
						<Border Grid.Column="0" Classes="inputBox" Background="#1A1A1A" CornerRadius="10" BorderThickness="1" Padding="16,14" VerticalAlignment="Stretch">
							<Grid>
								<TextBlock x:Name="WatermarkText" Text="Введіть дію, думку або фразу..." Foreground="#555555" IsHitTestVisible="False" Margin="4,0,0,0" FontStyle="Italic"/>
								<avedit:TextEditor x:Name="ChatInputEditor"
								                   IsEnabled="{Binding !IsTyping}"
								                   Background="Transparent" Foreground="#E5E7EB"
								                   WordWrap="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
								                   FontSize="15" MinHeight="20" MaxHeight="120">
									<avedit:TextEditor.ContextMenu>
										<ContextMenu>
											<MenuItem Header="Скасувати форматування (ПКМ)" Click="RemoveFormatting_Click"/>
										</ContextMenu>
									</avedit:TextEditor.ContextMenu>
								</avedit:TextEditor>
							</Grid>
						</Border>

						<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
							<Button Command="{Binding SendCommand}"
							        IsEnabled="{Binding !IsTyping}"
							        Classes="sendBtn"
							        Cursor="Hand"
							        ToolTip.Tip="Відправити (Enter)">
								<PathIcon Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Foreground="White" Width="18" Height="18" Margin="4,4,0,0"/>
							</Button>

							<Border Background="#2A2A2A" CornerRadius="16" Width="24" Height="24" Margin="12,0,0,12" VerticalAlignment="Bottom" Cursor="Help"
							        ToolTip.Tip="**Дія** — фізичні дії&#x0a;&#x0a;&quot;Думка&quot; — внутрішній голос&#x0a;&#x0a;- Репліка — пряма мова&#x0a;&#x0a;(OOC) — позаігрове, для ШІ">
								<TextBlock Text="?" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
							</Border>
						</StackPanel>
					</Grid>
				</Grid>
			</SplitView.Content>
		</SplitView>
	</Grid>
</Window>
