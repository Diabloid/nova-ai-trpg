<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaTrpgClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NovaTrpgClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NOVA AI TRPG" MinWidth="800" MinHeight="600"
        Background="#121212"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True">

	<Window.Styles>
		<Style Selector="ScrollBar">
			<Setter Property="AllowAutoHide" Value="False"/>
			<Setter Property="Width" Value="8"/>
		</Style>
		<Style Selector="ScrollBar /template/ Thumb">
			<Setter Property="Background" Value="#333333"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>
		<Style Selector="ScrollBar /template/ Thumb:pointerover">
			<Setter Property="Background" Value="#555555"/>
		</Style>

		<!-- ЕФЕКТИ ПОЛЯ ВВОДУ -->
		<Style Selector="Border.inputBox">
			<Setter Property="BorderBrush" Value="#333333"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.inputBox:focus-within">
			<Setter Property="BorderBrush" Value="#5A0010"/>
		</Style>

		<!-- БОРДОВА КНОПКА ВІДПРАВКИ -->
		<Style Selector="Button.sendBtn">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Width" Value="48"/>
			<Setter Property="Height" Value="48"/>
			<Setter Property="Background">
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
					<GradientStop Color="#4A000A" Offset="0.0"/>
					<GradientStop Color="#2A0005" Offset="1.0"/>
				</LinearGradientBrush>
			</Setter>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.2"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.sendBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background">
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
					<GradientStop Color="#6A0010" Offset="0.0"/>
					<GradientStop Color="#4A000A" Offset="1.0"/>
				</LinearGradientBrush>
			</Setter>
		</Style>

		<!-- КОНТЕКСТНЕ МЕНЮ (ПКМ) -->
		<Style Selector="MenuItem">
			<Setter Property="CornerRadius" Value="0"/>
			<!-- Прибрано Padding звідси -->
		</Style>
		<Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
			<Setter Property="Padding" Value="10,5"/>
			<!-- Додано сюди для правильного заповнення -->
			<Setter Property="CornerRadius" Value="6"/>
		</Style>
		<Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="#111111"/>
		</Style>

		<!-- СТИЛЬ TOOLTIP -->
		<Style Selector="ToolTip">
			<Setter Property="Background" Value="#111111"/>
			<Setter Property="BorderBrush" Value="#2A2A2A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#9CA3AF"/>
		</Style>

		<!-- КНОПКА МЕНЮ -->
		<Style Selector="ToggleButton.menuBtn">
			<Setter Property="Background" Value="#1A1A1A"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="BorderBrush" Value="#2A2A2A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.2"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="ToggleButton.menuBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#2A2A2A"/>
		</Style>
		<Style Selector="ToggleButton.menuBtn:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="#333333"/>
		</Style>
	</Window.Styles>

	<Grid>
		<!-- Основний макет зі SplitView -->
		<SplitView IsPaneOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                   DisplayMode="Inline"
                   OpenPaneLength="250"
                   PaneBackground="#111111"
                   Background="#121212">

			<!-- БІЧНЕ МЕНЮ (тепер на всю висоту) -->
			<SplitView.Pane>
				<Border BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
					<!-- Додано верхній відступ (60), щоб текст не налазив на заголовок -->
					<StackPanel Margin="20,60,20,20" Spacing="10">
						<TextBlock Text="МЕНЮ" HorizontalAlignment="Center" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,10" LetterSpacing="1"/>
						<Button Content="Чат" Background="#1A1A1A" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" CornerRadius="8"/>
					</StackPanel>
				</Border>
			</SplitView.Pane>

			<!-- ОСНОВНИЙ ІНТЕРФЕЙС -->
			<SplitView.Content>
				<!-- Додано Margin="24,40,24,24" (відступ 40 зверху для кнопок вікна) -->
				<Grid RowDefinitions="Auto, *, Auto" Margin="24,40,24,24">

					<!-- ВЕРХНЯ ПАНЕЛЬ -->
					<Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,16">
						<ToggleButton Grid.Column="0" Classes="menuBtn" IsChecked="{Binding IsMenuOpen, Mode=TwoWay}" Content="☰" Foreground="#E5E7EB" FontSize="20" Width="44" Height="44" Margin="0,0,16,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Cursor="Hand"/>
						<Border Grid.Column="1" Background="#1A1A1A" CornerRadius="10" Padding="20,14" BorderBrush="#2A2A2A" BorderThickness="1">
							<Grid ColumnDefinitions="*, Auto">
								<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
									<TextBlock Text="❤" Foreground="#EF4444" FontSize="14" Margin="0,1,0,0"/>
									<TextBlock Text="{Binding HpText}" Foreground="#FCA5A5" FontWeight="Bold" FontSize="15"/>
								</StackPanel>
								<TextBlock Grid.Column="1" Text="{Binding InventoryText}" Foreground="#9CA3AF" FontStyle="Italic" FontSize="14" VerticalAlignment="Center"/>
							</Grid>
						</Border>
					</Grid>

					<!-- ЛОГ ПОВІДОМЛЕНЬ + ІНДИКАТОР -->
					<Border Grid.Row="1" Background="#111111" CornerRadius="10" BorderBrush="#2A2A2A" BorderThickness="1" Padding="20,10,4,10">
						<ScrollViewer x:Name="ChatScroll" Padding="0,0,16,0">
							<StackPanel>
								<ItemsControl ItemsSource="{Binding ChatMessages}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,0,0,24">
												<TextBlock Text="{Binding Sender}" Foreground="{Binding SenderColor}" FontWeight="Bold" Margin="0,0,0,6" FontSize="15"/>
												<TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#E5E7EB" LineHeight="26" FontSize="15" LetterSpacing="0.3"/>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<!-- ІНДИКАТОР -->
								<StackPanel IsVisible="{Binding IsTyping}" Margin="0,0,0,24" Orientation="Vertical" Spacing="4">
									<TextBlock Text="Оповідач:" FontWeight="Bold" Foreground="#EAB308" FontSize="15"/>
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="Розмірковує над дією" FontStyle="Italic" Foreground="#9CA3AF" FontSize="15"/>
										<TextBlock Text="{Binding AnimatedDots}" FontStyle="Italic" Foreground="#9CA3AF" FontSize="15" Width="20"/>
									</StackPanel>
								</StackPanel>
							</StackPanel>
						</ScrollViewer>
					</Border>

					<!-- ПОЛЕ ВВОДУ ТА ЕЛЕМЕНТИ -->
					<Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,16,0,0">
						<Border Grid.Column="0" Classes="inputBox" Background="#1A1A1A" CornerRadius="10" BorderThickness="1" Padding="16,14" VerticalAlignment="Stretch">
							<Grid>
								<TextBlock x:Name="WatermarkText" Text="Введіть дію, думку або фразу..." Foreground="#555555" IsHitTestVisible="False" Margin="4,0,0,0" FontStyle="Italic"/>
								<avedit:TextEditor x:Name="ChatInputEditor"
                                                   IsEnabled="{Binding !IsTyping}"
                                                   Background="Transparent" Foreground="#E5E7EB"
                                                   WordWrap="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                   FontSize="15" MinHeight="20" MaxHeight="120">
									<avedit:TextEditor.ContextMenu>
										<ContextMenu>
											<MenuItem Header="Скасувати форматування (ПКМ)" Click="RemoveFormatting_Click"/>
										</ContextMenu>
									</avedit:TextEditor.ContextMenu>
								</avedit:TextEditor>
							</Grid>
						</Border>

						<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
							<Button Command="{Binding SendCommand}"
							        IsEnabled="{Binding !IsTyping}"
							        Classes="sendBtn"
							        Cursor="Hand"
							        ToolTip.Tip="Відправити (Enter)">
								<PathIcon Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Foreground="White" Width="18" Height="18" Margin="4,4,0,0"/>
							</Button>

							<Border Background="#2A2A2A" CornerRadius="16" Width="24" Height="24" Margin="12,0,0,12" VerticalAlignment="Bottom" Cursor="Help"
                                    ToolTip.Tip="**Дія** — фізичні дії&#x0a;&#x0a;&quot;Думка&quot; — внутрішній голос&#x0a;&#x0a;- Репліка — пряма мова&#x0a;&#x0a;(OOC) — позаігрове, для ШІ">
								<TextBlock Text="?" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
							</Border>
						</StackPanel>
					</Grid>
				</Grid>
			</SplitView.Content>
		</SplitView>
	</Grid>
</Window>